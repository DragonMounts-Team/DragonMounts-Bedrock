{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "dm:water_dragon_egg",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "dm:transformation_timer":{
        "minecraft:timer": {
          "time": 300,
          "looping": false,
          "time_down_event": {"event": "dm:test_transform"}
        }
      },
      "dm:dragon_hatched": {
        "minecraft:is_shaking": {},
        "minecraft:transformation": {
          "into": "dm:water_dragon",
          "begin_transform_sound": "block.turtle_egg.crack",
          "transformation_sound": "block.turtle_egg.crack",
          "delay": { "value": 60 }
        }
      },
      "dm:hatching":{
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            { "item": "minecraft:wheat", "growth": 0.03125 }
          ],
          "grow_up": {
            "event": "dm:dragon_egg_hatched",
            "target": "self"
          }
        }
      },
      "dm:hatch_trans":{
        "minecraft:ageable": {
          "duration": 900,
          "feed_items": [
            { "item": "minecraft:wheat", "growth": 0.03125 }
          ],
          "grow_up": {
            "event": "dm:dragon_egg_hatched",
            "target": "self"
          }
        }
      },
      "dm:transforming":{
        "minecraft:is_ignited": {}
      }
    },
    "components": {
      "minecraft:is_stackable": {},
      "minecraft:is_collidable": {},
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:interact": {
        "interactions": [
          {
            "cooldown": 0.0,
            "use_item": false,
            "play_sounds": "unfect",
            "interact_text": "action.interact.transform_block_dragon_eggs.dm",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_sneaking",
                    "subject": "player",
                    "operator": "equals",
                    "value": true
                  }
                ]
              },
              "event": "dm:back_to_block",
              "target": "self"
            }
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "lava", "deals_damage": false },
          { "cause": "fire", "deals_damage": false },
          { "cause": "fire_tick", "deals_damage": false }
        ]
      },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:collision_box": { "width": 0.8, "height": 1.0 },
      "minecraft:breathable": {
        "total_supply": 240,
        "suffocate_time": 0,
        "breathes_lava": true,
        "breathes_solids": true,
        "generates_bubbles": false
      },
      "minecraft:movement": { "value": 0.0 },
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": false },
      "minecraft:physics": { "has_gravity": true },
      "minecraft:type_family": {
        "family": [
          "player",
          "dragon",
          "dragon_egg",
          "dm"
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "dm:hatching","dm:transformation_timer" ] }
      },
      "dm:back_to_block": {},
      "dm:test_transform":{},
      "dm:dragon_egg_hatched": {
        "add": { "component_groups": [ "dm:dragon_hatched" ] }
      },
      "dm:hatch_trans": {
        "add": { "component_groups": [ "dm:hatch_trans" ] },
        "remove": { "component_groups": [ "dm:hatching","dm:transformation_timer" ] }
      }
    }
  }
}